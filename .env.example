# Public application origin used for local links and later OAuth configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Added in Issue #2. Safe to expose in browser code when required by Privy.
NEXT_PUBLIC_PRIVY_APP_ID=

# Added in Issue #2. Server-only; never prefix with NEXT_PUBLIC_.
PRIVY_APP_SECRET=

# Issue #3: public verification JWK copied from Privy dashboard, stored server-side.
PRIVY_JWT_VERIFICATION_KEY=

# Added in Issue #3. Server-only Postgres connection string.
DATABASE_URL=

# Issue #29: public Base recipient address for the $1 USDC verification payment.
NEXT_PUBLIC_VERIFICATION_RECIPIENT_ADDRESS=

# Optional server-only Base RPC URL; defaults to https://mainnet.base.org.
BASE_RPC_URL=
